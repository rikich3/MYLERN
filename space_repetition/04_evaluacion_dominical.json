{
  "name": "MILERN 04 - Evaluacion dominical",
  "meta": {
    "descripcion": "Caso de uso 2 'EVALUANDO APRENDIZAJE'. Cada domingo a las 00:00 UTC genera el cuestionario semanal con hasta 20 nodos activos en fase_3 o fase_4 y avisa por Telegram.",
    "especificaciones": [
      "PROC-EVAL-DIRECTA"
    ],
    "etiquetas": [
      "milern",
      "space-repetition"
    ]
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * 0"
            }
          ]
        }
      },
      "id": "a4000000-0000-4000-8000-000000000001",
      "name": "Domingo 00:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        0
      ],
      "notes": "El contenedor de n8n corre con GENERIC_TIMEZONE=UTC, de modo que el cron dispara a las 00:00 UTC exactas."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MILERN_API_BASE }}/api/v1/internal/evaluaciones/generar-semanal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.MILERN_INTERNAL_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "a4000000-0000-4000-8000-000000000002",
      "name": "Generar evaluaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "notes": "paso 1: selecciona aleatoriamente hasta 20 nodos activos en fase_3 o fase_4 y arma el cuestionario con nodo_esfuerzo como premisa contrastado contra nodo_crudo y los enlaces jerarquicos."
    },
    {
      "parameters": {
        "fieldToSplitOut": "generadas",
        "options": {}
      },
      "id": "a4000000-0000-4000-8000-000000000003",
      "name": "Una por usuario",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "tiene-chat",
              "leftValue": "={{ $json.telegram_chat_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "tiene-items",
              "leftValue": "={{ $json.total_items }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4000000-0000-4000-8000-000000000004",
      "name": "Avisable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=Tu evaluacion semanal esta lista: {{ $json.total_items }} items.\nComplétala en la app web, seccion Evaluaciones, o descarga el formato offline.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a4000000-0000-4000-8000-000000000005",
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        500,
        -80
      ],
      "credentials": {
        "telegramApi": {
          "id": "milern_telegram",
          "name": "Telegram MILERN"
        }
      },
      "notes": "paso 2: el usuario accede a la seccion de evaluaciones en la Web App o descarga el formato offline."
    },
    {
      "parameters": {},
      "id": "a4000000-0000-4000-8000-000000000006",
      "name": "Sin aviso",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        500,
        100
      ]
    }
  ],
  "connections": {
    "Domingo 00:00 UTC": {
      "main": [
        [
          {
            "node": "Generar evaluaciones",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generar evaluaciones": {
      "main": [
        [
          {
            "node": "Una por usuario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Una por usuario": {
      "main": [
        [
          {
            "node": "Avisable?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisable?": {
      "main": [
        [
          {
            "node": "Avisar por Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sin aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "active": false,
  "pinData": {}
}
