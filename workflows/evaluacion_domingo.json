{
  "name": "evaluacion_domingo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * 0"
            }
          ]
        }
      },
      "id": "e4bdd9a7-4dd8-4df6-a1dd-d6f2e488be5e",
      "name": "Domingo 00:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        80
      ],
      "notes": "El contenedor de n8n corre con GENERIC_TIMEZONE=UTC, de modo que el cron dispara a las 00:00 UTC exactas."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MILERN_API_BASE }}/api/v1/internal/evaluaciones/generar-semanal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.MILERN_INTERNAL_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "551e2371-44a4-46e4-ad29-0d54a6fee156",
      "name": "Generar evaluaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "paso 1: selecciona aleatoriamente hasta 20 nodos activos en fase_3 o fase_4 y arma el cuestionario con nodo_esfuerzo como premisa contrastado contra nodo_crudo y los enlaces jerarquicos."
    },
    {
      "parameters": {
        "fieldToSplitOut": "generadas",
        "options": {}
      },
      "id": "2c84fb00-78e9-48ee-a670-924559846d14",
      "name": "Una por usuario",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -460,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "tiene-chat",
              "leftValue": "={{ $json.telegram_chat_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "tiene-items",
              "leftValue": "={{ $json.total_items }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d54a392d-4eb6-42dc-b678-3622b9d48fb8",
      "name": "Avisable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        80
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=Tu evaluacion semanal esta lista: {{ $json.total_items }} items.\nComplétala en la app web, seccion Evaluaciones, o descarga el formato offline.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "8a16e8cb-7cad-402c-888b-24a2f34204ce",
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        100,
        -20
      ],
      "credentials": {
        "telegramApi": {
          "id": "BRBShQvaEppiHCtg",
          "name": "Telegram account"
        }
      },
      "notes": "paso 2: el usuario accede a la seccion de evaluaciones en la Web App o descarga el formato offline."
    },
    {
      "parameters": {},
      "id": "50cc01cf-98c6-4ba2-b1d4-aaeedafd6c3b",
      "name": "Sin aviso",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "61b16506-71c0-4bc5-a399-1da55fd4b7c7",
              "name": "item.contenido",
              "value": "={{ $json.item.contenido.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
              "type": "string"
            },
            {
              "id": "2d20b07a-c2e3-4a89-a392-da89fbda2e5b",
              "name": "item.chat_id",
              "value": "={{ $json.item.chat_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -100,
        -100
      ],
      "id": "2585f98d-3686-462f-8e55-52d375939386",
      "name": "Edit Fields"
    }
  ],
