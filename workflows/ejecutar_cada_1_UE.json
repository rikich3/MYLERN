{
  "name": "ejecutar_cada_1_UE",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "4adc99cd-dd54-4745-a76c-0679d36d11cf",
      "name": "Cada 1 UE (10 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "paso 1 'trigger cronometrado de despacho': cada 10 minutos el motor de tareas ejecuta el tick temporal. El backend calcula indice_global = floor(unix_timestamp / 600)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MILERN_API_BASE }}/api/v1/internal/scheduler/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.MILERN_INTERNAL_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "0ba522ff-b6ed-4c2c-98a0-03d07344b114",
      "name": "Ejecutar tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Ejecuta en una sola transaccion: archivado de nodos con indice_fecha_limite < indice_global, encolado de nodos candidatos (activo, fase 1-3 o fase_4 temporal, indice_siguiente_esfuerzo <= indice_global) y encolado de grafos elegibles con avance del cursor Round Robin y reagendamiento entre 54 y 66 UE."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "indice_global",
              "value": "={{ $json.indice_global }}",
              "type": "number"
            },
            {
              "id": "r2",
              "name": "nodos_archivados",
              "value": "={{ $json.nodos_archivados }}",
              "type": "number"
            },
            {
              "id": "r3",
              "name": "nodos_encolados",
              "value": "={{ $json.nodos_encolados }}",
              "type": "number"
            },
            {
              "id": "r4",
              "name": "grafos_encolados",
              "value": "={{ $json.grafos_encolados }}",
              "type": "number"
            },
            {
              "id": "r4b",
              "name": "en_silencio",
              "value": "={{ $json.en_silencio }}",
              "type": "boolean"
            },
            {
              "id": "r5",
              "name": "resumen",
              "value": "=UE {{ $json.indice_global }}: {{ $json.en_silencio ? \"HORAS DE SILENCIO, no se genera nada\" : $json.nodos_encolados + \" nodos + \" + $json.grafos_encolados + \" grafos encolados\" }}, {{ $json.nodos_archivados }} archivados",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "db5dc97c-86be-42c1-a6a3-0543cd2f395b",
      "name": "Resumen del tick",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "Deja trazabilidad del tick en el historial de ejecuciones de n8n. [feature 1.3] El backend comprueba primero si el indice cae en el rango 10pm - 7am; en ese caso solo archiva vencidos y no encola nada."
    }
  ],
  "pinData": {},
