# ============================================================================
# MILERN -- variables de entorno del despliegue
# Copiar a `.env` y ajustar. Pensado para un despliegue personal (un usuario)
# detras de Nginx Proxy Manager + Cloudflare.
# ============================================================================

# Dominio publico con el que sirves el sistema.
DOMINIO=milern.midominio.com

# --- [feature 1.3] Horas de silencio ----------------------------------------
# IMPORTANTE: la ventana es hora de RELOJ DE PARED. Sin la zona horaria
# correcta, los esfuerzos llegarian a deshora sin ningun error visible.
# Identificador IANA: America/Lima, Europe/Madrid, America/Mexico_City...
ZONA_HORARIA=America/Lima

SILENCIO_ACTIVO=true
SILENCIO_HORA_INICIO=22          # 10pm, inclusive
SILENCIO_HORA_FIN=7              # 7am, exclusive
SILENCIO_DESPLAZAMIENTO_UE=54    # 9 horas: lo que dura la ventana

# --- Puertos para el proxy externo ------------------------------------------
# Formato "ip:puerto". Con 127.0.0.1 solo se alcanzan desde la propia maquina.
# Si Nginx Proxy Manager corre en Docker en el mismo host, lo mejor es
# conectarlo a la red `milern_entrada` y enrutar por nombre de contenedor
# (backend:3000, webapp:80); en ese caso estos puertos ni se usan.
PUERTO_WEBAPP=127.0.0.1:8080
PUERTO_API=127.0.0.1:3000
PUERTO_N8N=127.0.0.1:5678
RED_ENTRADA=milern_entrada

# --- contenedor 03: PostgreSQL ----------------------------------------------
PGUSER=mylern
PGPASSWORD=cambia-esta-password
PGDATABASE=mylern

# --- contenedor 01: backend -------------------------------------------------
# Firma los tokens de sesion. Generalo con:  openssl rand -base64 36
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
JWT_TTL=720h
LOG_LEVEL=info
CORS_ORIGEN=https://milern.midominio.com

# Cuenta unica del sistema, creada en el primer arranque.
BOOTSTRAP_EMAIL=tu@correo.com
BOOTSTRAP_PASSWORD=cambia-esta-password-min-8
# Opcional: si ya conoces tu chat_id de Telegram, se vincula solo.
BOOTSTRAP_TELEGRAM_CHAT_ID=

# Caudal de despacho (procedimiento "recibiendo esfuerzos").
DESPACHO_MAX_POR_VENTANA=10
DESPACHO_ESPACIADO_SEG=60
DESPACHO_MAX_INTENTOS=3

# Items maximos de la evaluacion dominical (caso de uso 2).
EVALUACION_MAX_ITEMS=20

# --- contenedor 02: n8n -----------------------------------------------------
# n8n pide credenciales propias: no es seguridad "extra", es su funcionamiento.
N8N_USER=admin
N8N_PASSWORD=cambia-esta-password
# Cifra las credenciales que guarda n8n (el token del bot, entre ellas).
# Si la pierdes, hay que volver a crear la credencial de Telegram.
N8N_ENCRYPTION_KEY=cambia-esta-clave-de-al-menos-32-caract

# --- Medidas opcionales (apagadas) ------------------------------------------
# Ver docs/seguridad_removida.md: que hace cada una y cuando encenderla.

# Secreto compartido backend <-> n8n para /api/v1/internal/*.
# Vacio = desactivado. Enciendelo si publicas el puerto de la API mas alla de
# 127.0.0.1 o si el host es compartido.
INTERNAL_API_SECRET=

# Limitador de caudal de la API. true si alguna vez expones la API a terceros.
RATE_LIMIT_ACTIVO=false
RATE_LIMIT_MAX=300
