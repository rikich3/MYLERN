# ============================================================================
# MILERN -- variables de entorno del despliegue
# Copiar a `.env` y reemplazar TODOS los valores marcados como CAMBIAR.
# Generar secretos con:  openssl rand -base64 36
# ============================================================================

# Dominio publico servido por el reverse proxy TLS (contenedor 05).
DOMINIO=milern.example.com

# --- TLS y proxy de entrada -------------------------------------------------
# true SOLO si el trafico entra por Cloudflare (nube naranja activada).
# Restaura la IP real del visitante desde la cabecera CF-Connecting-IP; sin
# esto el limitador de caudal veria a todos los visitantes como un unico
# origen. Actívalo unicamente si Cloudflare esta realmente delante: confiar en
# esa cabecera sin un proxy conocido permite falsificar la IP.
CONFIAR_EN_CLOUDFLARE=false

# Correo para los avisos de caducidad de Let's Encrypt (opcional).
# Solo se usa con scripts/certificado.sh; no hace falta con Cloudflare Origin.
CERTBOT_EMAIL=

# --- contenedor 03: PostgreSQL ---------------------------------------------
PGUSER=mylern
PGPASSWORD=CAMBIAR_password_postgres
PGDATABASE=mylern

# --- contenedor 01: backend -------------------------------------------------
JWT_SECRET=CAMBIAR_secreto_jwt_minimo_32_caracteres
JWT_TTL=12h
# Secreto compartido backend <-> n8n para /api/v1/internal/*
INTERNAL_API_SECRET=CAMBIAR_secreto_interno_minimo_32_caracteres
LOG_LEVEL=info
CORS_ORIGEN=https://milern.example.com

# Caudal de despacho (procedimiento "recibiendo esfuerzos").
DESPACHO_MAX_POR_VENTANA=10
DESPACHO_ESPACIADO_SEG=60
DESPACHO_MAX_INTENTOS=3

# Items maximos de la evaluacion dominical (caso de uso 2).
EVALUACION_MAX_ITEMS=20

# Cuenta inicial creada al primer arranque (opcional pero recomendado).
BOOTSTRAP_EMAIL=operador@example.com
BOOTSTRAP_PASSWORD=CAMBIAR_password_inicial_min_8
# Opcional: vincula de una vez el chat de Telegram (obtener con /vincular).
BOOTSTRAP_TELEGRAM_CHAT_ID=

# --- contenedor 02: n8n -----------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_password_n8n
# Cifra las credenciales guardadas por n8n. Perderla invalida las credenciales.
N8N_ENCRYPTION_KEY=CAMBIAR_clave_cifrado_n8n_minimo_32

# --- herramienta CLI (opcional) --------------------------------------------
# API token emitido desde la app web (Perfil -> tokens) o por POST /api/v1/auth/tokens
MYLERN_CLI_TOKEN=
