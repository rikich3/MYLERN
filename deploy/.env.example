# ============================================================================
# MILERN -- variables de entorno del despliegue
# Copiar a `.env` y ajustar. Pensado para un despliegue personal (un usuario)
# detras de Nginx Proxy Manager + Cloudflare.
# ============================================================================

# Dominio publico con el que sirves el sistema.
DOMINIO=milern.frennow.app

# --- [feature 1.3] Horas de silencio ----------------------------------------
# IMPORTANTE: la ventana es hora de RELOJ DE PARED. Sin la zona horaria
# correcta, los esfuerzos llegarian a deshora sin ningun error visible.
# Identificador IANA: America/Lima, Europe/Madrid, America/Mexico_City...
ZONA_HORARIA=America/Lima

SILENCIO_ACTIVO=true
SILENCIO_HORA_INICIO=22          # 10pm, inclusive
SILENCIO_HORA_FIN=7              # 7am, exclusive
SILENCIO_DESPLAZAMIENTO_UE=54    # 9 horas: lo que dura la ventana

# --- Puertos para el proxy externo ------------------------------------------
# FORMATO: "ip:puerto", no solo el numero.
#   127.0.0.1:3000  -> solo desde la propia maquina  (lo que quieres)
#   3000            -> equivale a 0.0.0.0:3000, EXPUESTO A TODA LA RED
#
# Puedes borrar estas tres lineas o dejarlas vacias: se usan los mismos valores
# por defecto que ves aqui. Lo que NO hace el valor vacio es desactivar la
# publicacion; para eso esta docker-compose.proxy-propio.yml.
#
# Cambialos si alguno choca con otro servicio del VPS (el 8080 es el que mas
# suele estar ocupado).
PUERTO_WEBAPP=172.17.0.1:8080
PUERTO_API=172.17.0.1:3000
PUERTO_N8N=172.17.0.1:5678

# Si Nginx Proxy Manager corre en Docker en el mismo host, conectalo a esta red
# y enruta por nombre de contenedor (backend:3000, webapp:80, n8n:5678); en ese
# caso los puertos de arriba ni se usan.
RED_ENTRADA=milern_entrada

# --- contenedor 03: PostgreSQL ----------------------------------------------
PGUSER=mylern
PGPASSWORD=cambia-esta-password
PGDATABASE=mylern

# --- contenedor 01: backend -------------------------------------------------
# Firma los tokens de sesion. Generalo con:  openssl rand -base64 36
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
JWT_TTL=720h
LOG_LEVEL=info
# Origen exacto desde el que el NAVEGADOR abre la app: el mismo que ves en la
# barra de direcciones. Con esquema, SIN barra final y SIN ruta.
#   correcto:   https://milern.midominio.com
#   incorrecto: https://milern.midominio.com/     (la barra final no casa)
#   incorrecto: milern.midominio.com              (falta el esquema)
#
# Puedes borrar esta linea: por defecto se deriva como https://${DOMINIO}.
#
# Solo interviene si la SPA y la API viven en dominios DISTINTOS. Con la
# configuracion de la guia (todo bajo un mismo dominio) las peticiones son del
# mismo origen y CORS ni se evalua; queda como red de seguridad.
CORS_ORIGEN=https://milern.midominio.com

# Cuenta unica del sistema, creada en el primer arranque.
BOOTSTRAP_EMAIL=tu@correo.com
BOOTSTRAP_PASSWORD=cambia-esta-password-min-8
# Opcional: si ya conoces tu chat_id de Telegram, se vincula solo.
BOOTSTRAP_TELEGRAM_CHAT_ID=

# Caudal de despacho (procedimiento "recibiendo esfuerzos").
DESPACHO_MAX_POR_VENTANA=10
DESPACHO_ESPACIADO_SEG=60
DESPACHO_MAX_INTENTOS=3

# Items maximos de la evaluacion dominical (caso de uso 2).
EVALUACION_MAX_ITEMS=20

# --- contenedor 02: n8n -----------------------------------------------------
# Subdominio propio de n8n, si lo sirves aparte del principal.
# Dejalo vacio para servirlo bajo ${DOMINIO} en la ruta /webhook/.
# De aqui sale la URL base de los webhooks: si esta mal, Telegram entrega los
# mensajes a un dominio que no es el de n8n.
DOMINIO_N8N=n8n.midominio.com

# Cifra las credenciales que guarda n8n (el token del bot, entre ellas).
# Si la pierdes, hay que volver a crear la credencial de Telegram.
N8N_ENCRYPTION_KEY=cambia-esta-clave-de-al-menos-32-caract

# ATENCION: n8n 1.x NO tiene autenticacion basica. N8N_BASIC_AUTH_USER y
# N8N_BASIC_AUTH_PASSWORD se ignoran en silencio. La proteccion del editor es la
# cuenta de propietario, que se crea en el PRIMER acceso: entra tu antes de
# publicar el subdominio, o cualquiera que lo encuentre se quedara con tu n8n
# (y con el token de tu bot).

# --- Medidas opcionales (apagadas) ------------------------------------------
# Ver docs/seguridad_removida.md: que hace cada una y cuando encenderla.

# Secreto compartido backend <-> n8n para /api/v1/internal/*.
# Vacio = desactivado. Enciendelo si publicas el puerto de la API mas alla de
# 127.0.0.1 o si el host es compartido.
INTERNAL_API_SECRET=

# Limitador de caudal de la API. true si alguna vez expones la API a terceros.
RATE_LIMIT_ACTIVO=false
RATE_LIMIT_MAX=300
